# Copy this file to `.env` (gitignored) and fill in your own Cloudflare Worker
# URLs before building. Leave any value blank to disable that cloud backend
# by default in the APK (users can still override Community / RoadSense URLs
# from the in-app / Web UI settings if desired).

ANALYTICS_WORKER_URL=
COMMUNITY_WORKER_URL=
ROADSENSE_WORKER_URL=

# Used only by the `braveheart` buildType when uploading redacted daemon logs:
LOG_UPLOAD_URL=
